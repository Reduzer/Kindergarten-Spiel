<Window
    x:Class="KindergartenSpiel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KindergartenSpiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Background="Transparent"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">


    <Grid>

        <Grid Background="Transparent" Cursor="Hand">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#0d1d23"
                MouseDown="TitleBar_MouseDown" />

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="Minimieren"
                    Width="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Minimize_Click"
                    Cursor="Hand"
                    Foreground="White">
                    <Path Data="M20,14H4V10H20" Fill="White" />
                </Button>

                <Button
                    x:Name="Maximieren"
                    Width="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Maximize_Click"
                    Cursor="Hand"
                    Foreground="White">
                    <Path Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" Fill="White" />
                </Button>

                <Button
                    x:Name="Schließen"
                    Width="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click"
                    Cursor="Hand"
                    Foreground="White">
                    <Path Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M17,8.4L13.4,12L17,15.6L15.6,17L12,13.4L8.4,17L7,15.6L10.6,12L7,8.4L8.4,7L12,10.6L15.6,7L17,8.4Z" Fill="White" />
                </Button>
            </StackPanel>

            <!--  Navigationsbereich  -->


            <Image
                Grid.Row="1"
                Source="/Bilder/Hintergund.png"
                Stretch="Fill">

                <Image.Effect>
                    <BlurEffect Radius="8" />
                </Image.Effect>

            </Image>

            <Frame
                x:Name="NavFrame"
                Grid.Row="1"
                Background="Transparent"
                NavigationUIVisibility="Hidden" Cursor="" />

        </Grid>



    </Grid>
</Window>
