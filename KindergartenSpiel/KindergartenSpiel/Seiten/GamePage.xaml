<Page
    x:Class="KindergartenSpiel.Seiten.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KindergartenSpiel.Seiten"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GamePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="White" BorderThickness="1" Background="#4294c8">


            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Background="Transparent">
                    <TextBlock
                Margin="10"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Punkte: " />
                    <TextBlock
                x:Name="ScoreLabel"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Text="0"
                Margin="10"/>
                </StackPanel>


                <Button
            x:Name="StartButton"
            Grid.Column="1"
            Width="40"
            Height="40"                              
            BorderThickness="2"
            Click="StartGame_Click"
            Cursor="Hand"
            FontSize="18"
            FontWeight="Bold"
            Foreground="White"
            Style="{StaticResource Button}">

                    <Path
                Data="M10,16.5V7.5L16,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                Fill="White"
                Stretch="Fill" />
                </Button>


                <TextBlock
            x:Name="StatusLabel"
            Grid.Column="2"
            Margin="10,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="18"
            Foreground="White"
            Text="Klicke auf Play"
            TextWrapping="Wrap" />
            </Grid>

        </Border>


        <Canvas
        x:Name="GameCanvas"
        Grid.Row="1"
        Background="Transparent" />


        <Border
        x:Name="TargetShapeDisplay"
        Grid.RowSpan="2"
        Width="200"
        Height="200"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderBrush="White"
        BorderThickness="4"
        CornerRadius="10"
        Visibility="Collapsed">
            <StackPanel
            Margin="0,-10,0,0"
            VerticalAlignment="Center"
            Orientation="Vertical">


                <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#3F51B5"
                 />


                <ContentControl
                x:Name="TargetShapeText"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Viewbox 
        x:Name="RedCrossOverlay" 
        Grid.RowSpan="2" 
        Width="300" 
        Height="300" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center"
        Visibility="Collapsed" 
        IsHitTestVisible="False">

            <Path Data="M0,0 L100,100 M0,100 L100,0" 
              Stroke="Red" 
              StrokeThickness="10" 
              StrokeStartLineCap="Round" 
              StrokeEndLineCap="Round"
              Stretch="Uniform" 
              Width="100" 
              Height="100"/>
        </Viewbox>
    </Grid>
</Page>
