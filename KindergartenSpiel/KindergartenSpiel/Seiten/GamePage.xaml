<Page
    x:Class="KindergartenSpiel.Seiten.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KindergartenSpiel.Seiten"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GamePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="Transparent">

        <Border
            x:Name="TargetShapeContainer"
            Width="160"
            Height="160"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#111"
            BorderThickness="2"
            CornerRadius="10">

            <TextBlock
                x:Name="TargetShapeText"
                Text="Form"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#111"/>

        </Border>

    </Grid>
</Page>
